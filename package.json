    "@aws-sdk/lib-dynamodb": "3.1149.0",
    "aws-cdk-lib": "2.273.0",
    "constructs": "10.8.1"
  },
  "devDependencies": {
    "@types/aws-lambda": "8.10.164",
    "@types/node": "22.20.5",
    "aws-cdk": "2.1145.0",
    "esbuild": "0.28.2",
    "ts-node": "10.9.2",
    "tsx": "4.23.15",
    "typescript": "5.8.3"
